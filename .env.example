# Optional: Adsgram rewarded-ad block id. Leave empty to keep ads fully off.
# Rules.txt forbids ads on custom-URL pages; enable this only when Telegram's
# own monetization terms allow it for your app.
VITE_ADSGRAM_BLOCK_ID=

# Optional: fallback bot username (without @) if getMe is unavailable during
# bootstrap. The server normally discovers it automatically.
VITE_BOT_USERNAME=

# Set to 1 for static demo builds (GitHub Pages). Forces the local backend and
# skips Telegram Serverless calls; progress is stored in the browser only.
VITE_LOCAL_ONLY=
